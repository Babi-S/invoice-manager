{
  "name": "invoice-manager-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:api": "node --env-file-if-exists=.env --test test/api.smoke.js",
    "import:sample": "node --env-file-if-exists=.env scripts/import-sample.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "pdfkit": "^0.20.2"
  }
}
