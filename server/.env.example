# Server binds to localhost only (the app has no login).
HOST=127.0.0.1
PORT=5050

# Existing MongoDB connection. Credentials stay on the server only.
MONGODB_URI=mongodb://127.0.0.1:27017/invoice_manager

# Existing collections the app READS customers and services from (never written to).
CUSTOMER_COLLECTION=customers
SERVICE_COLLECTION=services

# Optional: override auto-detected field names (dot paths allowed, e.g. contact.email)
# CUSTOMER_FIELD_NAME=
# CUSTOMER_FIELD_EMAIL=
# CUSTOMER_FIELD_PHONE=
# CUSTOMER_FIELD_ADDRESS=
# SERVICE_FIELD_NAME=
# SERVICE_FIELD_DESCRIPTION=
# SERVICE_FIELD_PRICE=
